# ============================================================
# WAYZYY AI TRIP CONCIERGE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and populate with your actual keys to enable LIVE MODE.
# If these variables are left empty, the application automatically runs in DEMO MODE.

# Server Configuration
PORT=3000
NODE_ENV=development

# Claude API (Anthropic)
# Required for LIVE AI generation (Itinerary, Concierge chat, Adaptation phrasing)
# Example: sk-ant-api03-xxxx...
CLAUDE_API_KEY=

# OpenWeatherMap API
# Required for LIVE weather data fetching for Goa / trip destinations
# Example: 4a3f2b1c8e...
OPENWEATHER_API_KEY=

# Telegram Bot API
# Required for sending actual Telegram messages to guests
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Optional Webhook Secret for securing incoming booking webhook payloads
WAYZYY_WEBHOOK_SECRET=

# Google Sheets Dataset ID (Optional, defaults to local curated dataset)
GOOGLE_SHEET_ID=
